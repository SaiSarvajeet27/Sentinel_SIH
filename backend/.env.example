# Copy to .env and fill in the two keys. Nothing else needs changing.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit it, and never paste a key into a chat,
# an issue, or a slide — rotate immediately if you do.

# ── Database ────────────────────────────────────────────────────────────
# SQLite by default: no server to install, no database to create, and the
# file is made for you on first bootstrap. This is the path the README's
# quick start describes, so it ships as the active line — a fresh clone
# should run without editing anything here.
DATABASE_URL=sqlite+pysqlite:///./sentinel.db
# For the production-shaped path, install Postgres, run `createdb sentinel`,
# then comment the line above and uncomment this one:
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel

# ── LLM providers ───────────────────────────────────────────────────────
# Gemini — used for scenario generation, one call per demo run. Get a key
# at https://aistudio.google.com/apikey — new keys start "AQ." and that is
# correct; the "AIza" format is being retired.
#
# Free-tier limits vary per project and Google no longer publishes a fixed
# table — one observed project measured 20 requests/day for
# gemini-2.5-flash, well below the old default of 180. Check yours at
# https://aistudio.google.com/rate-limit and set the two numbers below to
# match. The defaults are deliberately pessimistic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=8
GEMINI_RPD=20

# Groq — carries every task that repeats (explain, triage, correlate,
# analysis, assess, remediation). Its free tier is a larger, published
# fixed number rather than a per-project Gemini allocation. Get a key at
# https://console.groq.com/keys. Use a current model id — Groq retires
# models; check https://console.groq.com/docs/models for the list.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM=25
GROQ_RPD=900

# Ollama — local fallback, no key. Set the routing below to `ollama` for a
# fully air-gapped demo, which is the answer to requirement 11.
#   ollama pull qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Task → provider routing ─────────────────────────────────────────────
# Options per task: gemini | groq | ollama | off
# Every entry here is a real call site. Set all of them to `ollama` for the
# offline demo — missing one leaves a hosted call in an "air-gapped" run.
LLM_SCENARIO=gemini
LLM_EXPLAIN=groq
LLM_ANALYSIS=groq
LLM_ASSESS=groq
LLM_TRIAGE=groq
LLM_CORRELATE=groq
LLM_SCORE=off            # duplicates LLM_ASSESS; off saves a request
LLM_REMEDIATION=groq

# Two analysts, or one. false = rules only, and the interface says so.
DUAL_PATH=true

# Master switch. false = the whole app runs with no model at all.
# This is the demo control that proves the model holds no authority —
# the verdict must be identical either way.
AI_ENABLED=true

# ── Authentication ──────────────────────────────────────────────────────
# There is no demo mode. Every route needs a bearer token and every mutating
# route checks a role, because "nothing irreversible without a named human"
# stops being true the moment a bypass exists.
#
# Leave JWT_SECRET_KEY empty and one is generated and saved to
# db/jwt_secret.key on first run. Set it explicitly for a real deployment.
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=480

# Bootstrap creates three accounts, one per role, so you can demonstrate
# that an analyst *cannot* approve what a senior analyst can. Leave a
# password blank and bootstrap.py generates one and prints it once instead
# — safer for a real deployment, but it means every teammate's fresh clone
# gets a *different*, unknown password, which is exactly what breaks "here
# are the login details" for a shared team demo. Fixed, known passwords
# below on purpose so the whole team gets the same working accounts.
# (bootstrap.py silently regenerates any password under 12 characters, so
# keep these at least that long if you change them.) The admin email must
# stay admin@sentinel.local — the login page's UI hints and its "Fill
# manager email" button are hardcoded to that address, not this variable.
BOOTSTRAP_ADMIN_EMAIL=admin@sentinel.local
BOOTSTRAP_ADMIN_PASSWORD=SecureAdminPass123!
BOOTSTRAP_SENIOR_EMAIL=simran@sentinel.local
BOOTSTRAP_SENIOR_PASSWORD=SecureSeniorPass123!
BOOTSTRAP_ANALYST_EMAIL=arjun@sentinel.local
BOOTSTRAP_ANALYST_PASSWORD=SecureAnalystPass123!

# ── Free-tier budget ────────────────────────────────────────────────────
# Gemini carries everything now, so the budget is much tighter than it was.
# A full run costs about 6 calls with regenerate=False. Check your actual
# daily limit — if it is low, REHEARSE ON OLLAMA and save Gemini for the
# take you are filming. `python scripts/use_local.py` switches in one
# command. Repeats of the same scenario are served from cache and cost
# nothing.

# ── App ─────────────────────────────────────────────────────────────────
# Comma-separated. `localhost` and `127.0.0.1` are different origins to a
# browser even though they're the same machine — both are listed so it
# doesn't matter which one you type into the address bar.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ── Simulation ──────────────────────────────────────────────────────────
SIM_HOSTS=12
SIM_USERS=25

# ── Live incident generation ────────────────────────────────────────────
# Runs a full attack scenario on its own, on this interval, with no manual
# "demo" button: a fresh Gemini-authored plan, real detection, real
# dual-path AI analysis, real remediation proposal. One Gemini call per
# cycle — 15 minutes is ~96 cycles/day, which will run past a typical
# ~20/day Gemini free-tier project quota a few hours in. That's fine on
# purpose: app/llm/router.py falls back Gemini -> Groq -> Ollama
# automatically, so cycles past Gemini's daily allowance still get a
# fresh AI-authored scenario, just from Groq (900/day, easily covers the
# rest of the day at ~6 Groq calls/cycle). Raise this if incidents feel
# too frequent, or if you'd rather more cycles land on Gemini specifically.
# A restart does not "waste" a cycle either way: it checks the `runs`
# table for when the last one actually happened rather than always firing
# immediately. Set AUTO_GENERATE_ENABLED=false to turn it off entirely
# (e.g. to control AI spend by hand instead).
AUTO_GENERATE_ENABLED=true
AUTO_GENERATE_INTERVAL_MINUTES=15
